# ============================================================
# JobShield AI — Environment Variables Reference
# ============================================================
# Copy this file to .env for local development.
# .env is gitignored and must NEVER be committed.
# Set these variables directly in the Render dashboard for
# production deployment (not via a .env file on Render).
# ============================================================


# ------------------------------------------------------------
# BACKEND (Render Web Service)
# ------------------------------------------------------------

# Allowed CORS origin(s) for the FastAPI backend.
# Set this to your deployed Streamlit Cloud URL once known.
# Multiple origins can be comma-separated.
# Use * only for local development — never in production.
#
# Example (production):
#   FRONTEND_ORIGIN=https://your-app-name.streamlit.app
#
# Example (local dev):
#   FRONTEND_ORIGIN=*
FRONTEND_ORIGIN=*

# SQLAlchemy database URL.
# Defaults to SQLite (ephemeral on Render free tier — history
# will not persist across redeploys or service restarts).
# To persist history, provision a Render PostgreSQL instance
# and set DATABASE_URL to the provided connection string.
# No code change is required — SQLAlchemy handles both dialects.
#
# Example (SQLite, local or Render free tier):
#   DATABASE_URL=sqlite:///./jobshield.db
#
# Example (PostgreSQL, Render paid tier or external):
#   DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./jobshield.db


# ------------------------------------------------------------
# FRONTEND (Streamlit Community Cloud)
# ------------------------------------------------------------

# URL of the deployed FastAPI backend on Render.
# Set this as a Streamlit Cloud secret (Settings → Secrets) in
# TOML format, or as an environment variable if self-hosting.
#
# Example:
#   JOBSHIELD_API_URL=https://jobshield-ai-backend.onrender.com
#
# Local development default (already hardcoded as fallback in
# frontend/app.py — no action needed for local runs):
#   JOBSHIELD_API_URL=http://127.0.0.1:8000
JOBSHIELD_API_URL=http://127.0.0.1:8000
